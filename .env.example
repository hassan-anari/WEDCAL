DJANGO_SETTINGS_MODULE=dexo_land.settings.local
DJANGO_SECRET_KEY=local-only-change-before-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_TRUST_X_FORWARDED_PROTO=false
DJANGO_TRUST_PROXY_CLIENT_IP=false
DJANGO_MAX_REQUEST_BODY_BYTES=1048576
OPERATIONS_METRICS_TOKEN=local-only-operations-token
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
POSTGRES_DB=dexo_land
POSTGRES_USER=dexo_land
POSTGRES_PASSWORD=dexo_land_local
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_POOL_ENABLED=false
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
REDIS_URL=redis://redis:6379/0
RABBITMQ_DEFAULT_USER=dexo_land
RABBITMQ_DEFAULT_PASS=dexo_land_local
CELERY_BROKER_URL=amqp://dexo_land:dexo_land_local@rabbitmq:5672//
TELEGRAM_BOT_TOKEN=development-placeholder-token
TELEGRAM_WEBHOOK_SECRET=development-placeholder-secret
TELEGRAM_BOT_ID=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
TELEGRAM_API_GLOBAL_RPS=25
TELEGRAM_API_METHOD_RPS=15
TELEGRAM_API_DEFAULT_RETRY_SECONDS=60
TELEGRAM_API_RETRY_JITTER_SECONDS=30
TELEGRAM_INGRESS_RETENTION_SECONDS=604800
TELEGRAM_INGRESS_PURGE_INTERVAL_SECONDS=3600
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_TASK_TIME_LIMIT=300
THROTTLE_BASE_TAP_REQUESTS=120
THROTTLE_BASE_TAP_WINDOW_SECONDS=60
THROTTLE_TYPING_REQUESTS=60
THROTTLE_TYPING_WINDOW_SECONDS=60
THROTTLE_MISSION_REQUESTS=60
THROTTLE_MISSION_WINDOW_SECONDS=60
SEASON_CLOSE_RECHECK_SECONDS=300
# B2 is disabled until owner-approved migration and paired frontend E2E.
TAP_V2_ISSUANCE_ENABLED=false
BASE_TAP_LEGACY_INGRESS_ENABLED=true
TAP_V2_PLAYER_REQUESTS=240
TAP_V2_SESSION_REQUESTS=180
AVATAR_CACHE_ENABLED=false
AVATAR_CACHE_TTL_SECONDS=604800
AVATAR_CACHE_MAX_BYTES=2097152
AVATAR_CACHE_MAX_PIXELS=16000000
AVATAR_CACHE_RETRY_SECONDS=900
AVATAR_CACHE_MAX_CONCURRENT_REFRESHES=2
AVATAR_S3_BUCKET=
AVATAR_S3_ENDPOINT_URL=
AVATAR_S3_REGION=us-east-1
AVATAR_PUBLIC_API_ORIGIN=https://api.dalexio.com
# Use AWS SDK environment/role credentials via secret management; never commit credentials.
